#!/bin/bash
# Run `make install` on a fresh Ubuntu in a throwaway container, then `doctor`.
# Catches renamed packages and broken recipes before you set up a real machine.
# Can't test the desktop itself (sway, Noctalia), only that everything installs and links.
#
#   UBUNTU=26.04 scripts/test
set -euo pipefail

cd "$(dirname "$0")/.."

UBUNTU=${UBUNTU:-26.04}

# ship the working tree (including uncommitted files) into the container
git ls-files -co --exclude-standard | tar -c -T - | docker run --rm -i "ubuntu:$UBUNTU" bash -c '
    set -euo pipefail
    useradd -m -s /bin/bash tester
    mkdir /home/tester/dotfiles && tar -x -C /home/tester/dotfiles && chown -R tester: /home/tester/dotfiles

    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq && apt-get install -y -qq sudo make git </dev/null >/dev/null
    echo "tester ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/tester

    sudo -u tester -H bash -c "
        set -e
        cd ~/dotfiles
        export GIT_AUTHOR_NAME=tester GIT_AUTHOR_EMAIL=tester@localhost GIT_COMMITTER_NAME=tester GIT_COMMITTER_EMAIL=tester@localhost
        git init -q && git add -A && git commit -qm test
        make install
        # fisher rewrites fish_plugins on install; commit that so doctor only reports real drift
        git add -A && git -c commit.gpgSign=false commit -qm installed --allow-empty
        ./scripts/doctor
    " </dev/null
'
